{
  "type": "module",
  "name": "@cakriwut/omp-model-router",
  "version": "0.8.1",
  "description": "Cost-optimized model routing for Oh-My-Pi — routes prompts to cheap/mid/expensive models based on task complexity. Tracks per-turn and session costs. Uses TOON compression for conversation history optimization.",
  "author": "Riwut Libinuko <cakriwut@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cakriwut/omp-model-router.git"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "omp-router": "./src/cli/index.ts"
  },
  "files": [
    "src",
    "model-router.example.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "./scripts/test-summary.sh",
    "test:verbose": "bun test --dots",
    "deploy:dev": "./scripts/deploy-dev.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "model-router",
    "ai",
    "llm",
    "cost-optimization",
    "routing",
    "extension",
    "toon-compression"
  ],
  "bugs": {
    "url": "https://github.com/cakriwut/omp-model-router/issues"
  },
  "homepage": "https://github.com/cakriwut/omp-model-router#readme",
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "^15.5.2",
    "@oh-my-pi/pi-agent-core": "^15.5.2",
    "@oh-my-pi/pi-ai": "^15.5.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "omp": {
    "repository": "https://github.com/can1357/oh-my-pi",
    "type": "extension",
    "extensions": [
      "src/index.ts"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1061.0",
    "bun-types": "^1.3.14"
  },
  "dependencies": {
    "@toon-format/toon": "^2.3.0"
  }
}
