    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "oh-my-pi",
    "model-router",
    "ai",
    "cost-optimization",
    "llm",
    "routing",
    "chatgpt",
    "claude",
    "gemini"
  ],
